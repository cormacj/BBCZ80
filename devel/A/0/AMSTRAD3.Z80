;
	GLOBAL	CLG
	GLOBAL	COLOUR
	GLOBAL	DRAW
	GLOBAL	ENVEL
	GLOBAL	GCOL
	GLOBAL	MODE
	GLOBAL	MOVE
	GLOBAL	PLOT
	GLOBAL	SOUND
	GLOBAL	PUTIMS
	GLOBAL	CIRCLE
	GLOBAL	ELLIPS
	GLOBAL	FILL
	GLOBAL	MOUSE
	GLOBAL	ORIGIN
	GLOBAL	RECTAN
	GLOBAL	LINE
	GLOBAL	TINT
	GLOBAL	WAIT
	GLOBAL	SYS
	GLOBAL	CSRON
	GLOBAL	CSROFF
;
	GLOBAL	ADVAL
	GLOBAL	POINT
	GLOBAL	GETIMS
	GLOBAL	TINTFN
	GLOBAL	MODEFN
	GLOBAL	WIDFN
;
	EXTRN	EXTERR
    EXTRN   XEQ
;
    ; BDOS EQU 5
    PRINT_S EQU 9
MODE:

; =====================================================================
; Z80 Assembly Routine to Print a Null-Terminated String
; =====================================================================
    push ix
    ; push iy
    LD (SETMODE),A
    ld hl, MODESTR        ; Load the starting address of the string into HL
    call print_string     ; Call the string printing subroutine
    ; pop iy
    pop ix
    xor a
    JP XEQ
    ; ret                   ; Return to the operating system / main program

print_string:
    ld a, (hl)            ; Load the character from memory address HL into register A
    or a                  ; Test if A is 0 (sets the Zero flag if A == 0, clearing Carry)
    ret z                 ; If the Zero flag is set (end of string), return from subroutine
    PUSH HL
    call print_char       ; Call your platform's single-character print routine
    POP HL
    inc hl                ; Increment HL to point to the next character in memory
    jr print_string       ; Jump back to the loop start using a relative jump

; =====================================================================
; Platform-Specific Single-Character Output Examples
; =====================================================================
print_char:
    ; CHOOSE ONE OF THE FOLLOWING BASED ON YOUR SYSTEM:

    ; --- Option A: ZX Spectrum ---
    ; rst $10             ; Built-in ROM call to print the ASCII char in register A
    ; ret

    ; --- Option B: CP/M Operating System ---
    ld c, 2             ; CP/M BDOS function 2: Console Output
    ld e, a             ; CP/M expects the character in register E
    jp 5            ; Call BDOS (it handles its own return)

    ; --- Option C: Amstrad CPC ---
    ; call $BB5A          ; Firmware call 'TXT OUTPUT' prints character in A
    ; ret

; =====================================================================
; Data Section
; =====================================================================
my_string:
    defb "Hello, World!", 0   ; The string data, terminated with a null byte (0)

;
MODESTR:
    ;CRT codes for MODE
    DEFB    27
    DEFB    '3'
SETMODE:
    DEFB    0
    ;CRT code to reset cursor
    DEFB    27
    DEFB    'H'
    ; DEFB    '0'
    defb    0
CMG:
    DEFM 'Ok, did that work...',10,13,'$'
    DEFB  0
CLG:
COLOUR:
DRAW:
ENVEL:
GCOL:
MOVE:
PLOT:
SOUND:
ADVAL:
POINT:
GETIMS:
PUTIMS:
CIRCLE:
ELLIPS:
FILL:
MOUSE:
ORIGIN:
RECTAN:
LINE:
TINT:
TINTFN:
MODEFN:
WIDFN:
WAIT:
SYS:
CSRON:
CSROFF:
	XOR	A
	CALL	EXTERR
	DEFM	'Sorry'
	DEFB	0
;
	END
